{
  "name": "@urantia/auth",
  "version": "0.3.0",
  "description": "Sign-in with a UrantiaHub account, for a browser or a server (accounts.urantiahub.com)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "urantia",
    "auth",
    "oauth",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urantiahub/urantia-dev-sdks",
    "directory": "packages/auth"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "engines": {
    "node": ">=18"
  }
}
